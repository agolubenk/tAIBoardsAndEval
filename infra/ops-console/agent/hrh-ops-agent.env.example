# /etc/hrh-ops-agent.env — права 600, владелец root. Значения из «Настройки → Агенты» консоли.
OPS_CONSOLE_URL=https://ops.example.vercel.app
OPS_AGENT_ID=main-vps
OPS_AGENT_SECRET=hrhops_...
OPS_AGENT_INTERVAL=15

# Основной стек — имя проекта docker compose продукта (у HR Helper — backend). Агент ≥ 1.5 показывает
# контейнеры всех проектов хоста; основной — первым, и только у него «остановлен» = алерт при любой
# restart policy (у соседних — если контейнер по политике должен работать). До 1.5 был фильтром.
OPS_COMPOSE_PROJECT=
# Не показывать вовсе (glob по имени контейнера), например одноразовые: buildx_buildkit_*,*-run-*
OPS_CONTAINER_EXCLUDE=
# Контейнеры каких compose-проектов консоль может перезапускать (glob; без проекта — пустое имя).
# По умолчанию — только OPS_COMPOSE_PROJECT, а если он пуст — все, как до 1.5.
OPS_RESTART_PROJECTS=
# Что можно перезапускать из консоли (glob) и что нельзя никогда. Решение владельца: можно всё,
# stateful — только с вводом имени в консоли. DENY — второй рубеж на самом хосте.
OPS_RESTART_ALLOW=*
OPS_RESTART_DENY=
OPS_RESTART_COOLDOWN_SEC=120
# Дополнительно считать stateful (к эвристике консоли: postgres, redis, minio, clickhouse, kafka…).
OPS_STATEFUL=

OPS_DISK_MOUNTS=/
# Трафик за минуту («Трафик и бизнес-метрики» на странице сервера). nginx на самом сервере —
# путь к access.log; nginx в Docker агент находит сам (сервис compose «nginx» в OPS_COMPOSE_PROJECT)
# или по имени контейнера. В консоль уходят только счётчики и шаблоны путей (:id вместо id).
NGINX_ACCESS_LOG=/var/log/nginx/access.log
# NGINX_CONTAINER=backend-nginx-1
# Домены (вкладка «Домены» в инфраструктуре, агент ≥ 1.5): server_name из `nginx -T` раз в 10 мин, срок сертификата —
# локальным рукопожатием с SNI раз в 6 ч. Пусто — сервис compose «nginx» или образ nginx в любом проекте; маски через
# запятую — только эти контейнеры; «-» — не собирать. В консоль уходят имена, порт и срок, не конфигурация.
# Чужой стек — это автоматический docker exec в его контейнер: на хосте нужен runc ≥ 1.1.12, иначе — маска своих nginx.
OPS_NGINX_CONTAINERS=
# VPN (агент ≥ 1.6): файл корневого сборщика hrh-ops-vpn.service; «-» — не читать. Имена пиров по адресу в туннеле.
# PTR-имена адресов направлений (видит только владелец) — фоновый обратный DNS с кэшем на сутки; 0 — не спрашивать.
# Байты по направлениям — только с sysctl net.netfilter.nf_conntrack_acct=1, иначе — число соединений.
# OPS_VPN_FILE=/run/hrh-ops-vpn/vpn.json
# OPS_VPN_PEERS=10.77.0.2=Mac,10.77.0.3=Телефон
# OPS_VPN_PTR=1
# Бизнес-метрики: {"имя": "команда, печатающая одно число"} — выполняются на хосте, не из консоли,
# раз в BUSINESS_INTERVAL_SEC (по умолчанию 300). Только агрегаты: число строк, размер — не данные людей.
# HR Helper — скрипт рядом с агентом (install.sh ставит его в /opt/hrh-ops), запросы только на чтение. Правила P0
# (docs/ops/p0-slo-alerts.md) рассчитаны на интервал 300 с и полный набор ключей:
# BUSINESS_INTERVAL_SEC=300
# BUSINESS_CMDS={"companies":"/opt/hrh-ops/hrh-business.sh companies","users":"/opt/hrh-ops/hrh-business.sh users","db_size_mb":"/opt/hrh-ops/hrh-business.sh db_size_mb","stt_failed_1h":"/opt/hrh-ops/hrh-business.sh stt_failed_1h","stt_stuck":"/opt/hrh-ops/hrh-business.sh stt_stuck","stt_orphaned":"/opt/hrh-ops/hrh-business.sh stt_orphaned","stt_queue_waiting":"/opt/hrh-ops/hrh-business.sh stt_queue_waiting","tg_api_5xx_pct":"/opt/hrh-ops/hrh-business.sh tg_api_5xx_pct","tg_api_503_pct":"/opt/hrh-ops/hrh-business.sh tg_api_503_pct","tg_evictions_1h":"/opt/hrh-ops/hrh-business.sh tg_evictions_1h","tg_subs_coverage_pct":"/opt/hrh-ops/hrh-business.sh tg_subs_coverage_pct","hf_refresh_rejected":"/opt/hrh-ops/hrh-business.sh hf_refresh_rejected","hf_refresh_errors_6h":"/opt/hrh-ops/hrh-business.sh hf_refresh_errors_6h"}
