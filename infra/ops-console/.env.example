# HR Helper Ops — переменные окружения консоли. Локально: скопировать в .env (в git не попадает).

# Владелец, создаваемый при первом запуске (если пользователей ещё нет). Пароль ≥ 10 символов.
OPS_ADMIN_EMAIL=owner@example.com
OPS_ADMIN_PASSWORD=

# Ключ шифрования секретов (токены каналов, агентов, GitHub). На проде обязателен.
# Сгенерировать: openssl rand -base64 32. Смена ключа = все сохранённые секреты нужно ввести заново.
OPS_ENCRYPTION_KEY=

# База: локально — файл SQLite (по умолчанию file:./data/ops.db); на Vercel — Turso.
# OPS_DATABASE_URL=libsql://<db>-<org>.turso.io
# OPS_DATABASE_AUTH_TOKEN=

# Публичный адрес консоли — для ссылок в уведомлениях и env агента.
OPS_PUBLIC_URL=http://localhost:8797
OPS_PORT=8797

# Токен для /api/cron/tick (Vercel Cron шлёт Authorization: Bearer $CRON_SECRET; внешний пингер — так же).
# OPS_CRON_SECRET=

# Локальный планировщик в процессе (на Vercel выключается сам). off — только внешний cron.
# OPS_SCHEDULER=on
# OPS_SCHEDULER_INTERVAL_SEC=20

# Вход через платформу (SSO, продукт — IdP). Все три пусты — кнопки «Войти через платформу» нет.
# OPS_SSO_PRODUCT_URL — адрес SPA продукта (браузер идёт на /admin/ops-console-sso);
# OPS_SSO_API_URL — куда консоль ходит server-side (по умолчанию = OPS_SSO_PRODUCT_URL);
# OPS_SSO_CLIENT_SECRET — тот же, что OPS_SSO_CLIENT_SECRET у backend продукта.
# OPS_SSO_PRODUCT_URL=http://localhost:3000
# OPS_SSO_API_URL=http://localhost:3001
# OPS_SSO_CLIENT_SECRET=

# Вложения входящих очереди (/api/oq/v1/files). Каталог по умолчанию — рядом с файлом SQLite (<папка базы>/oq-files);
# без файловой базы (Turso, Vercel) вложения выключены. Остальное — лимиты, см. README «Очередь владельца».
# OQ_FILES_DIR=./data/oq-files
# OQ_FILES_MAX_MB=20
# OQ_FILES_MAX_PER_ITEM=10
# OQ_FILES_TOTAL_CAP_MB=4096
# OQ_FILES_FREE_RESERVE_MB=1024
# OQ_FILES_RETENTION_DAYS=90
# OQ_FILES_KINDS=image,pdf,doc,sheet,text
