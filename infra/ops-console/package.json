{
  "name": "hrh-ops-console",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "HR Helper Ops — автономная консоль мониторинга, алертов и перезапуска контейнеров (вне npm workspaces продукта).",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:api": "tsx watch --env-file-if-exists=.env server/local.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "tsx --env-file-if-exists=.env server/local.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env server/db/migrate-cli.ts",
    "build:vercel": "node scripts/build-vercel.mjs",
    "oq": "tsx --env-file-if-exists=.env server/queue/cli.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "@libsql/client": "^0.18.0",
    "@resvg/resvg-js": "^2.6.2",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.13.13",
    "nodemailer": "^10.3.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tanstack/react-query": "^5.104.1",
    "@types/node": "^26.6.4",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.25.12",
    "qrcode-generator": "^1.4.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4",
    "tsx": "^4.23.15",
    "typescript": "~5.7",
    "vite": "^6.4.4",
    "vitest": "^3.2.7"
  }
}
