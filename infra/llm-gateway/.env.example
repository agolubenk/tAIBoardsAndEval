# Локальный LLM-шлюз — шаблон. Рабочая копия: infra/llm-gateway/.env (gitignored, chmod 600).
# После правки: npm run llm-gateway:restart && npm run llm-gateway:sync

# ── Ключи OpenRouter (до 9; пустой ключ = слот выключен) ────────────────────────
# OPENROUTER_MODELS_<n> — какие модели обслуживает ключ: точные id через запятую или глоб (`*:free`, `deepseek/*`).
#   Пусто — ключ берёт любую модель. Точные id из всех ключей образуют пул `auto` (порядок — как здесь).
# OPENROUTER_RPM_<n> — свой темп ключа, запросов в минуту (free-tier OpenRouter ≈ 20/мин и 50/сутки,
#   1000/сутки при балансе ≥ $10). Лимиты считаются на аккаунт: 3 ключа одного аккаунта ёмкость не утроят.
OPENROUTER_KEY_1=
OPENROUTER_MODELS_1=
OPENROUTER_RPM_1=20

OPENROUTER_KEY_2=
OPENROUTER_MODELS_2=
OPENROUTER_RPM_2=20

OPENROUTER_KEY_3=
OPENROUTER_MODELS_3=
OPENROUTER_RPM_3=20

# ── GLM (Z.AI): два контура биллинга, смешивать нельзя ─────────────────────────
# Coding — подписка (плата за ВЫЗОВ, не токены): правило .continue/rules/04-model-rotation.md.
# Ключ тот же, что ZAI_API_KEY в .continue/.env. GLM_MODELS_CODING пусто — дефолт-лестница
# glm-4.6,glm-4.7,glm-5,glm-5.2 (решение владельца 2026-10-29: round-robin между ступенями).
ZAI_CODING_KEY=
GLM_MODELS_CODING=glm-4.6,glm-4.7,glm-5,glm-5.2
GLM_CODING_RPM=20
# General — кошелёк (плата за токены, реальные деньги). Ключ добавляется ТОЛЬКО с явным
# списком моделей; бесплатный glm-4.7-flash проверен рабочим 2026-10-29.
ZAI_GENERAL_KEY=
GLM_MODELS_GENERAL=
GLM_GENERAL_RPM=20

# ── Пулы моделей (имя в клиенте = имя пула в нижнем регистре, `_` → `-`) ────────
# Встроенные: `auto` (все точные модели ключей; если их нет — топ бесплатных с tools по каталогу),
#   `free` (бесплатные), `glm` (ротация GLM Z.AI), `cascade` (OpenRouter → GLM → local),
#   `local` (ротация локальных по возможностям запроса), `local/auto` (загруженная в Ollama сейчас),
#   `local/<tier>` (code|reason|long|fast), `local/<имя>`.
# Элемент пула может быть локальным: `local/glm46v:24k`.
# GW_ALIAS_CODER=qwen/qwen3-coder:free,deepseek/deepseek-chat-v3.1:free
# GW_ALIAS_FAST=meta-llama/llama-3.3-70b-instruct:free,local/auto

# ── Локальная ротация (Ollama) ─────────────────────────────────────────────────
# Тиры — явные списки; пусто = авто: code по имени (coder/tiel/…), reason (deepseek-r/think),
# long — окно ≥ 64k, fast — модель до ~7 ГБ. Vision/audio-запросы сами идут только к
# моделям с соответствующей capability.
# GW_LOCAL_CODE=tiel-coder:35b-a3b-iq3s
# GW_LOCAL_REASON=deepseek-r1:7b-qwen-distill-q4_K_M
# GW_LOCAL_LONG=glm4:latest,tiel-coder:35b-a3b-iq3s
# GW_LOCAL_FAST=glm4:latest,qwen2.5:7b

# ── Поведение ────────────────────────────────────────────────────────────────
# roundrobin — пул начинается с разной модели на каждый запрос; priority — всегда с первой здоровой.
GW_STRATEGY=roundrobin
# Каскад: сколько подряд отказов провайдера пропускают его остаток (OR упал → GLM → local).
GW_PROVIDER_SKIP_AFTER=3
# Сколько бесплатных моделей брать в `auto`, если ключам не заданы модели.
GW_AUTO_FREE_COUNT=8
# Минимальный интервал между запросами одного ключа, мс (замедление поверх RPM).
GW_MIN_INTERVAL_MS=1000
# Сколько ждать освобождения ключа/модели, прежде чем отдать 429, мс.
GW_MAX_WAIT_MS=45000
# Попыток (модель × ключ) на один запрос клиента.
GW_MAX_ATTEMPTS=8
# Одновременных запросов в облако; локальные — всегда строго по одному.
GW_MAX_CONCURRENCY=4
# Фолбэк на локальную модель, когда облако недоступно (запрос длиннее окна локальной туда не уходит).
GW_FALLBACK_LOCAL=1
# OpenRouter — только бесплатные (`:free` или нулевая цена в каталоге). Платный id от клиента уходит
# в свой `:free`-вариант или в пул `free`, сам он в OpenRouter не отправляется. 0 — разрешить платные.
GW_OPENROUTER_FREE_ONLY=1
# Потолок max_tokens / max_completion_tokens для облака (меньший запрос клиента не трогается; у OpenRouter —
# ещё и не выше максимума модели по каталогу). 0 — без потолка.
GW_MAX_OUTPUT_TOKENS=32768

# ── Локальные модели (Ollama) ────────────────────────────────────────────────
GW_LOCAL=1
OLLAMA_URL=http://127.0.0.1:11434
# Модель для local/auto, если в памяти ничего не загружено (иначе — загруженная).
GW_LOCAL_DEFAULT=
# Подстроки имён, которые не считать чатовыми.
GW_LOCAL_EXCLUDE=embed,nomic,minicpm-o
# Окно локальной модели без num_ctx в Modelfile: Ollama грузит её с OLLAMA_CONTEXT_LENGTH сервера (шлюз его не
# знает) — держать не выше него. Длинный промпт на ноутбуке = минуты префилла и гигабайты KV-кэша.
GW_LOCAL_MAX_CONTEXT=32768
# Роли Continue в сгенерированном .continue/agents/llm-gateway.yaml — напрямую в Ollama (пишутся, только
# если модель установлена; пусто — не писать роль).
GW_CONTINUE_AUTOCOMPLETE=tiel-coder-fim:latest
GW_CONTINUE_EMBED=nomic-embed-text:latest

# ── Вход ──────────────────────────────────────────────────────────────────────
GW_PORT=8789
# Токен клиентов. Пусто — сгенерируется в .state/token; клиенты получают его через `npm run llm-gateway:sync`.
GW_TOKEN=
