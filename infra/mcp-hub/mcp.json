{
  "mcpServers": {
    "serena": {
      "type": "http",
      "url": "http://127.0.0.1:${SERENA_HTTP_PORT}/mcp",
      "tags": ["code"]
    },
    "ai-council": {
      "command": "python3",
      "args": ["infra/ai-council/mcp_server.py"],
      "cwd": "${HR_HELPER_ROOT}",
      "restartOnExit": true,
      "tags": ["project"]
    },
    "owner-queue": {
      "command": "node",
      "args": ["infra/owner-queue-mcp/server.mjs"],
      "cwd": "${HR_HELPER_ROOT}",
      "restartOnExit": true,
      "tags": ["project"]
    },
    "headroom": {
      "command": "headroom",
      "args": ["mcp", "serve"],
      "restartOnExit": true,
      "tags": ["context"]
    },
    "mcp-search": {
      "command": "sh",
      "args": ["infra/mcp-hub/claude-mem-mcp.sh"],
      "cwd": "${HR_HELPER_ROOT}",
      "restartOnExit": true,
      "tags": ["memory"]
    },
    "docker": {
      "command": "uvx",
      "args": ["mcp-server-docker"],
      "restartOnExit": true,
      "disabledTools": ["create_container", "run_container", "recreate_container", "remove_container", "remove_image", "remove_volume", "remove_network", "push_image"],
      "tags": ["infra"]
    },
    "markitdown": {
      "command": "uvx",
      "args": ["markitdown-mcp@0.0.1a7"],
      "restartOnExit": true,
      "tags": ["docs"]
    },
    "dams-rag": {
      "command": "python3",
      "args": ["infra/mcp-hub/dams_rag_server.py"],
      "cwd": "${HR_HELPER_ROOT}",
      "restartOnExit": true,
      "tags": ["code", "project"]
    },
    "git": {
      "command": "uvx",
      "args": ["mcp-server-git@2026.8.18", "--repository", "${HR_HELPER_ROOT}"],
      "restartOnExit": true,
      "disabledTools": ["git_commit", "git_add", "git_reset", "git_create_branch", "git_checkout"],
      "tags": ["git"]
    },
    "postgres-readonly": {
      "command": "bash",
      "args": ["infra/scripts/dev-ai/mcp-postgres.sh"],
      "cwd": "${HR_HELPER_ROOT}",
      "restartOnExit": true,
      "tags": ["db"]
    },
    "github": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": { "Authorization": "Bearer ${GITHUB_PAT}" },
      "tags": ["remote"]
    },
    "notion": {
      "type": "http",
      "url": "https://mcp.notion.com/mcp",
      "tags": ["remote", "oauth"]
    },
    "sentry": {
      "type": "http",
      "url": "https://mcp.sentry.dev/mcp",
      "tags": ["remote", "oauth"]
    },
    "cloudflare": {
      "type": "http",
      "url": "https://mcp.cloudflare.com/mcp",
      "tags": ["remote", "oauth"]
    },
    "context7": {
      "type": "http",
      "url": "https://mcp.context7.com/mcp",
      "tags": ["docs", "oauth"]
    },
    "t-boards": {
      "command": "bash",
      "args": ["infra/scripts/dev-ai/mcp-t-boards.sh"],
      "cwd": "${HR_HELPER_ROOT}",
      "restartOnExit": true,
      "tags": ["remote", "boards"]
    },
    "linear": { "type": "http", "url": "https://mcp.linear.app/mcp", "disabled": true, "tags": ["connector"] },
    "atlassian": { "type": "http", "url": "https://mcp.atlassian.com/v1/mcp", "disabled": true, "tags": ["connector"] },
    "asana": { "type": "sse", "url": "https://mcp.asana.com/sse", "disabled": true, "tags": ["connector"] },
    "clickup": { "type": "http", "url": "https://mcp.clickup.com/mcp", "disabled": true, "tags": ["connector"] },
    "monday": { "type": "http", "url": "https://mcp.monday.com/mcp", "disabled": true, "tags": ["connector"] },
    "figma": { "type": "http", "url": "https://mcp.figma.com/mcp", "disabled": true, "tags": ["connector"] },
    "canva": { "type": "http", "url": "https://mcp.canva.com/mcp", "disabled": true, "tags": ["connector"] },
    "magnific": { "type": "http", "url": "https://mcp.magnific.com", "disabled": true, "tags": ["connector"] },
    "posthog": { "type": "http", "url": "https://mcp.posthog.com/mcp", "disabled": true, "tags": ["connector"] },
    "intercom": { "type": "http", "url": "https://mcp.intercom.com/mcp", "disabled": true, "tags": ["connector"] },
    "postman": { "type": "http", "url": "https://mcp.postman.com/minimal", "disabled": true, "tags": ["connector"] },
    "exa": { "type": "http", "url": "https://mcp.exa.ai/mcp", "disabled": true, "tags": ["connector"] }
  }
}
