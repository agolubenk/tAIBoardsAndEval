// For format details, see https://aka.ms/devcontainer.json.
{
	"name": "aiBoards & eval",
	"image": "mcr.microsoft.com/devcontainers/typescript-node:1-24-bookworm",
	"features": {
		"ghcr.io/devcontainers/features/git:1": {},
		"ghcr.io/devcontainers/features/python:1": {
			"version": "3.13"
		}
	},
	"postCreateCommand": "corepack enable && pnpm --dir boards install --frozen-lockfile",
	"forwardPorts": [1337, 5173],
	"customizations": {
		"vscode": {
			"extensions": ["dbaeumer.vscode-eslint", "oxc.oxc-vscode"]
		}
	}
}
