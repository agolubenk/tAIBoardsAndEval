{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(npm run *)",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/pre-tool-use-wt-deps.sh\"",
            "timeout": 10
          },
          {
            "type": "command",
            "if": "Bash(npm test*)",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/pre-tool-use-wt-deps.sh\"",
            "timeout": 10
          },
          {
            "type": "command",
            "if": "Bash(npm -w *)",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/pre-tool-use-wt-deps.sh\"",
            "timeout": 10
          },
          {
            "type": "command",
            "if": "Bash(npm --workspace *)",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/pre-tool-use-wt-deps.sh\"",
            "timeout": 10
          },
          {
            "type": "command",
            "if": "Bash(npx *)",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/pre-tool-use-wt-deps.sh\"",
            "timeout": 10
          },
          {
            "type": "command",
            "if": "Bash(pnpm *)",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/pre-tool-use-wt-deps.sh\"",
            "timeout": 10
          },
          {
            "type": "command",
            "if": "Bash(vp *)",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/pre-tool-use-wt-deps.sh\"",
            "timeout": 10
          },
          {
            "type": "command",
            "if": "Bash(make check-boards*)",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/pre-tool-use-wt-deps.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/user-prompt-submit.py\"",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/context-threshold.py\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/post-tool-use.py\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/post-tool-use-lint.py\"",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/post-session.py\"",
            "timeout": 20
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/stop-dams-reindex.py\"",
            "timeout": 60
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/stop-typecheck-gate.py\"",
            "timeout": 95
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "typescript-lsp@claude-plugins-official": true,
    "kotlin-lsp@claude-plugins-official": true,
    "swift-lsp@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "redis-development@claude-plugins-official": true,
    "clickhouse-best-practices@claude-plugins-official": true,
    "playwright@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "agent-sdk-dev@claude-plugins-official": true,
    "mcp-server-dev@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "chrome-devtools-mcp@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "feature-dev@claude-plugins-official": true,
    "serena@claude-plugins-official": true,
    "plugin-dev@claude-plugins-official": true,
    "claude-security@claude-plugins-official": true,
    "session-report@claude-plugins-official": true,
    "project-artifact@claude-plugins-official": true,
    "claude-mem-cowork@thedotmack": true
  }
}
