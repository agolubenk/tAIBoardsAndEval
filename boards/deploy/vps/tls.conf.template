# TLS in front of the bundled t-boards image. On the VPS it listens on the
# WireGuard address only (scheme A): nothing answers for t-boards on the public
# interface. wg0 PostUp redirects tunnel traffic for :443 to TLS_LISTEN.
# install.sh renders the three ${TLS_*} placeholders into /opt/t-boards/tls.conf.
worker_processes 1;
error_log /dev/stderr warn;
pid /tmp/nginx.pid;

events {
  worker_connections 512;
}

http {
  include /etc/nginx/mime.types;
  default_type application/octet-stream;
  server_tokens off;
  access_log off;

  map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
  }

  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_prefer_server_ciphers off;
  ssl_session_cache shared:SSL:1m;
  ssl_session_timeout 1d;

  server {
    listen ${TLS_LISTEN} ssl;
    http2 on;
    server_name ${TLS_DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${TLS_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${TLS_DOMAIN}/privkey.pem;

    add_header Strict-Transport-Security "max-age=31536000" always;

    # The image's own nginx sets the remaining security headers and the
    # 25 MB body limit; this one must not be lower.
    client_max_body_size 25m;

    location / {
      proxy_pass http://${TLS_UPSTREAM};
      proxy_http_version 1.1;
      proxy_set_header Host $host;
      proxy_set_header Upgrade $http_upgrade;
      proxy_set_header Connection $connection_upgrade;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-For $remote_addr;
      proxy_set_header X-Forwarded-Proto https;
      # WebSockets and MCP streams stay open; idle ones close after an hour.
      proxy_read_timeout 1h;
      proxy_send_timeout 1h;
    }
  }
}
