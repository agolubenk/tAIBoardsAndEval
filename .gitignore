.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Testing
coverage
logs/
browserstack-artifacts/

# Turbo
.turbo

# Vercel
.vercel

# Build Outputs
.next/
out/
build
dist
.source

# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Misc
.DS_Store
*.pem

# DB
*.db

# Cache
.cache/

# Local worktrees
.worktrees/

# Overrides
compose.override.yml

# IntelliJ IDE
.idea

# TanStack Router generated cache
boards/apps/web/.tanstack/
.pi/
.superpowers/

# TypeScript incremental build state
*.tsbuildinfo
.vitest/

# t-boards: local secret files (AUTH_SECRET_FILE, POSTGRES_PASSWORD_FILE)
.secrets/

# eval: python artifacts and daemon runtime state
__pycache__/
*.py[cod]
.pytest_cache/
eval/nerve/state/
eval/swarm/state/

# process layer: instance runtime (never the product itself)
.claude/memory/session/
.claude/settings.local.json
.claude/settings.local.json.bak-*
.claude/skill-observations/
.claude/scheduled_tasks.lock
CLAUDE.local.md
.ai/tmp/

# git worktrees (worktrees/README.md)
worktrees/*
!worktrees/README.md
.claude/worktrees/

# dev-AI infra runtime: council state, gateway state, graphify output
.claude/council/
infra/llm-gateway/.state/
infra/ops-console/data/
graphify-out/
**/graphify-out/

# .ai/task/<TASK-ID>/ — живые папки дел (brief, recon, evidence, выгрузки): рантайм инстанса, не продукт
.ai/task/
!.ai/README.md
!.ai/templates/

# generated by `npm run llm-gateway:sync`
.continue/agents/llm-gateway.yaml

# Strix profile (infra/scripts/README.md)
infra/scripts/security/.env.strix
